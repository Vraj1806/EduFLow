# ===== EduFlow API environment variables =====
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Node
NODE_ENV=development
PORT=4000

# Database (SQLite). Relative path is resolved against prisma/schema.prisma,
# so `file:./dev.db` creates apps/api/prisma/dev.db.
# PostgreSQL is also supported: set DATABASE_URL to a postgres:// URL and run
# `npm run prisma:migrate -w apps/api` (see prisma/migrations — Postgres SQL).
DATABASE_URL="file:./dev.db"

# Auth secrets. Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_TOKEN_SECRET=change-me-access
REFRESH_TOKEN_SECRET=change-me-refresh

# Token lifetimes (jsonwebtoken expiry strings)
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL=7d

# Cookies
# Set COOKIE_SECURE=true in production (HTTPS only).
COOKIE_SECURE=false

# AI service (optional). Leave AI_ENABLED=false until a provider is configured.
# The AI endpoints return a clear "not configured" error when disabled.
AI_ENABLED=false
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ML face-recognition sidecar (apps/ml). Keep ML_ENABLED=false until the sidecar
# is running on ML_SERVICE_URL. ML_SERVICE_SECRET is REQUIRED when ML_ENABLED=true —
# the sidecar rejects requests that don't carry it (X-ML-Service-Secret header).
# Defense-in-depth: still bind the sidecar to 127.0.0.1 (or an internal-only
# network) so it is never reachable from the public internet.
ML_ENABLED=true
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_SECRET=change-me-ml-secret
# Real face recognition (InsightFace) by default; use `demo` for offline dev.
ML_BACKEND=insightface

# Seed admin (used by `npm run db:seed -w apps/api`)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@eduflow.local
ADMIN_PASSWORD=change-me-123

# Notification delivery (SMTP). Disabled by default — the queue still records
# notifications, but they stay PENDING and nothing is sent (never faked).
# PRODUCTION NOTE: the worker that drains this queue does NOT run inside Vercel
# serverless functions. Run it as a long-lived process (Railway/Render/Fly/VPS)
# with DATABASE_URL + SMTP_* + NOTIFICATIONS_ENABLED=true, or drain via an
# authenticated cron trigger. See src/services/notificationWorker.ts.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduFlow <no-reply@eduflow.local>"
# How often the worker drains PENDING notifications (ms) and max retries.
NOTIFICATION_POLL_MS=30000
NOTIFICATION_MAX_ATTEMPTS=3

# Profile-photo object storage.
#   none  (default) — keep profile photos as inline data URLs in the DB
#   local           — write files under apps/api/uploads and serve /uploads/*
#   s3              — S3-compatible bucket (S3_* vars required)
STORAGE_PROVIDER=none
STORAGE_DIR=uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
